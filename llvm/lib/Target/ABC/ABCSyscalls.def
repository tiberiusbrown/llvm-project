// ABC syscall table. Keep the source-level asm label, display name, and VM
// syscall number together so the target printer, assembler, and Clang frontend
// agree on the same set of syscalls.
//
//   ABC_SYSCALL(display_name, asm_label, vm_number)

ABC_SYSCALL(debug_break,  "$debug_break",  28)
ABC_SYSCALL(debug_printf, "$debug_printf", 29)

