//===----------------------------------------------------------------------===//
//
// Measured AVM instruction costs for tune CPU avm-interpreter-32u4-v1.
//
// Provenance:
//   Repository: tiberiusbrown/avm
//   File:       bench/cycles_instruction.txt
//   Blob:       63cd3602b6d1ce25a1c1372690859f4c3a6714f0
//
// The fixed and branch costs are copied verbatim from the benchmark. Range
// entries use the predetermined representative Typical/Minimum/Maximum values
// specified by the AVM LLVM backend implementation plan. This file is checked
// in and must not be regenerated as part of an LLVM build.
//
// Define any subset of the following before including this file:
//
//   AVM_FIXED_COST(Name, Cycles)
//   AVM_RANGE_COST(Name, Typical, Minimum, Maximum)
//   AVM_BRANCH_COST(Name, NotTaken, Taken)
//   AVM_SHIFT_COST(Name, Count, Cycles)
//
// Undefined macros default to no-ops and are undefined again at the end.
//
//===----------------------------------------------------------------------===//

#ifndef AVM_FIXED_COST
#define AVM_FIXED_COST(Name, Cycles)
#define AVM_CYCLE_COSTS_UNDEF_FIXED
#endif

#ifndef AVM_RANGE_COST
#define AVM_RANGE_COST(Name, Typical, Minimum, Maximum)
#define AVM_CYCLE_COSTS_UNDEF_RANGE
#endif

#ifndef AVM_BRANCH_COST
#define AVM_BRANCH_COST(Name, NotTaken, Taken)
#define AVM_CYCLE_COSTS_UNDEF_BRANCH
#endif

#ifndef AVM_SHIFT_COST
#define AVM_SHIFT_COST(Name, Count, Cycles)
#define AVM_CYCLE_COSTS_UNDEF_SHIFT
#endif

