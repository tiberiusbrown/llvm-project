name: multiple_readers
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r4, $r6, $r7
    ; CHECK-LABEL: name: multiple_readers
    ; CHECK: CMP $r6, $r7, implicit-def $cc
    ; CHECK-NEXT: $r4 = CMOV_ULT $r4, $r6, implicit $cc
    ; CHECK-NEXT: $r4 = CMOV_UGE $r4, $r7, implicit $cc
    ; CHECK-NEXT: RET
    CMP $r6, $r7, implicit-def $cc
    $r5 = CSET_ULT implicit $cc
    TST8 $r5, implicit-def $cc
    $r4 = CMOV_NE $r4, $r6, implicit $cc
    $r4 = CMOV_EQ $r4, $r7, implicit $cc
    RET implicit $r4, implicit-def dead $sp, implicit $sp
...
---
name: preserve_boolean_data
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r4, $r6, $r7
    ; CHECK-LABEL: name: preserve_boolean_data
    ; CHECK: $r5 = CSET_ULT implicit $cc
    ; CHECK-NEXT: $r4 = CMOV_ULT $r4, $r6, implicit $cc
    ; CHECK-NEXT: ST16 $r7, $r5
    CMP $r6, $r7, implicit-def $cc
    $r5 = CSET_ULT implicit $cc
    TST8 $r5, implicit-def $cc
    $r4 = CMOV_NE $r4, $r6, implicit $cc
    ST16 $r7, $r5
    RET implicit $r4, implicit-def dead $sp, implicit $sp
...
---
