    liveins: $r4, $r6, $r7
    ; CHECK-LABEL: name: preserve_boolean_pair_alias
    ; CHECK: $r5 = CSET_ULT implicit $cc
    ; CHECK-NEXT: $r4 = CMOV_ULT $r4, $r6, implicit $cc
    ; CHECK-NEXT: RET implicit $r4r5
    CMP $r6, $r7, implicit-def $cc
    $r5 = CSET_ULT implicit $cc
    TST8 $r5, implicit-def $cc
    $r4 = CMOV_NE $r4, $r6, implicit $cc
    RET implicit $r4r5, implicit-def dead $sp, implicit $sp
...
---
name: flags_reader_between_set_and_test
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r4, $r6, $r7
    ; CHECK-LABEL: name: flags_reader_between_set_and_test
    ; CHECK: $r4 = CMOV_SLT $r4, $r7, implicit $cc
    ; CHECK-NEXT: $r4 = CMOV_ULT $r4, $r6, implicit $cc
    CMP $r6, $r7, implicit-def $cc
    $r5 = CSET_ULT implicit $cc
    $r4 = CMOV_SLT $r4, $r7, implicit killed $cc
    TST8 $r5, implicit-def $cc
    $r4 = CMOV_NE $r4, $r6, implicit $cc
    RET implicit $r4, implicit-def dead $sp, implicit $sp
...
---
name: stop_at_new_compare
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r4, $r6, $r7
    ; CHECK-LABEL: name: stop_at_new_compare
    ; CHECK: $r4 = CMOV_ULT $r4, $r6, implicit $cc
    ; CHECK-NEXT: CMP $r6, $r7, implicit-def $cc
    ; CHECK-NEXT: $r4 = CMOV_EQ $r4, $r7, implicit $cc
    CMP $r6, $r7, implicit-def $cc
    $r5 = CSET_ULT implicit $cc
    TST8 $r5, implicit-def $cc
    $r4 = CMOV_NE $r4, $r6, implicit $cc
    CMP $r6, $r7, implicit-def $cc
    $r4 = CMOV_EQ $r4, $r7, implicit $cc
