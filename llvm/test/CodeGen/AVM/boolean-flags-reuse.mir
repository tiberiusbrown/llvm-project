# RUN: llc -mtriple=avm -O2 -run-pass=avm-late-peephole,dead-mi-elimination \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

--- |
  target triple = "avm"
  declare void @callee()
  define void @cmov_eq_ne() { ret void }
  define void @branch_eq_ne() { ret void }
  define void @cmov_eq_eq() { ret void }
  define void @branch_eq_eq() { ret void }
  define void @cmov_ne_ne() { ret void }
  define void @branch_ne_ne() { ret void }
  define void @cmov_ne_eq() { ret void }
  define void @branch_ne_eq() { ret void }
  define void @cmov_ult_ne() { ret void }
  define void @branch_ult_ne() { ret void }
  define void @cmov_ult_eq() { ret void }
  define void @branch_ult_eq() { ret void }
  define void @cmov_uge_ne() { ret void }
  define void @branch_uge_ne() { ret void }
  define void @cmov_uge_eq() { ret void }
  define void @branch_uge_eq() { ret void }
  define void @cmov_slt_ne() { ret void }
  define void @branch_slt_ne() { ret void }
  define void @cmov_slt_eq() { ret void }
  define void @branch_slt_eq() { ret void }
  define void @cmov_sge_ne() { ret void }
  define void @branch_sge_ne() { ret void }
  define void @cmov_sge_eq() { ret void }
  define void @branch_sge_eq() { ret void }
  define void @multiple_readers() { ret void }
  define void @preserve_boolean_data() { ret void }
  define void @preserve_boolean_pair_alias() { ret void }
  define void @flags_reader_between_set_and_test() { ret void }
  define void @stop_at_new_compare() { ret void }
  define void @keep_clobbered_flags() { ret void }
  define void @keep_changed_boolean() { ret void }
  define void @keep_changed_pair() { ret void }
  define void @keep_unsupported_flags_reader() { ret void }
  define void @keep_liveout_flags() { ret void }
  define void @keep_across_call() { ret void }
  define void @test_reused_boolean_twice() { ret void }
  define void @retarget_materialized_flags_user() { ret void }
...
---
name: cmov_eq_ne
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r4, $r6, $r7
    ; CHECK-LABEL: name: cmov_eq_ne
    ; CHECK: CMP $r6, $r7, implicit-def $cc
    ; CHECK-NEXT: $r4 = XOR $r4, $r4
    ; CHECK-NEXT: $r4 = CMOV_EQ $r4, $r6, implicit $cc
    ; CHECK-NEXT: RET
    CMP $r6, $r7, implicit-def $cc
    $r5 = CSET_EQ implicit killed $cc
    $r4 = XOR $r4, $r4
    TST8 killed $r5, implicit-def $cc
    $r4 = CMOV_NE $r4, $r6, implicit killed $cc
    RET implicit $r4, implicit-def dead $sp, implicit $sp
...
---
name: branch_eq_ne
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r4, $r6, $r7
    ; CHECK-LABEL: name: branch_eq_ne
    ; CHECK: CMP $r6, $r7, implicit-def $cc
    ; CHECK-NEXT: RELAX_BR_EQ %bb.2, implicit $cc
    CMP $r6, $r7, implicit-def $cc
    $r5 = CSET_EQ implicit killed $cc
    TST16 killed $r5, implicit-def $cc
    RELAX_BR_NE %bb.2, implicit killed $cc
    RELAX_JMP %bb.1

  bb.1:
    liveins: $r4
    RET implicit $r4, implicit-def dead $sp, implicit $sp

  bb.2:
    liveins: $r4
    RET implicit $r4, implicit-def dead $sp, implicit $sp
...
---
