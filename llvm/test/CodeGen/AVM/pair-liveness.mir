# RUN: llc -mtriple=avm -run-pass=greedy,virtregrewriter -verify-machineinstrs %s -o - | FileCheck %s
# A consumed low word must not stay live while the high word crosses a block.
---
name: high_word_liveout
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $r4r5
    %0:gpr32 = COPY $r4r5
    %1:gpr16 = COPY %0.sub_lo16
    $r6 = COPY %1
    ST16 $r6, $r6
    RELAX_JMP %bb.1

  bb.1:
    ; CHECK-LABEL: name: high_word_liveout
    ; CHECK: bb.1:
    ; CHECK: liveins: $r4r5:0x0000000000000001
    ; CHECK: $r4 = COPY killed $r5
    %2:gpr16 = COPY %0.sub_hi16
    $r4 = COPY %2
    RET_PSEUDO implicit-def dead $sp, implicit $sp, implicit $r4
...
