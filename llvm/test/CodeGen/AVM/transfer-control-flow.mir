# RUN: llc -mtriple=avm -run-pass=avm-late-peephole -verify-machineinstrs %s -o - | FileCheck %s
# These look redundant in linear disassembly, but a loop enters between the
# transfers. The second operation must remain for the other incoming path.
# Genuine same-block round trips are already covered by redundant-values.mir.
---
name: loop_entry_transfers
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 1 }
  - { id: 1, type: spill-slot, size: 2, alignment: 1 }
body: |
  bb.0:
    successors: %bb.1
    liveins: $r4r5, $sp
    ; CHECK-LABEL: name: loop_entry_transfers
    ; CHECK: $r0r1 = MOV32_F2 $r4r5
    ; CHECK: $r6 = LDSP16 0
    ; CHECK: STSP16 2, $r4
    $r0r1 = MOV32_F2 $r4r5
    $r6 = LDSP16 0, implicit $sp :: (load (s16) from %stack.0, align 1)
    STSP16 2, $r4, implicit $sp :: (store (s16) into %stack.1, align 1)

  bb.1:
    successors: %bb.1, %bb.2
    liveins: $r0r1, $r6, $sp
    ; CHECK: bb.1:
    ; CHECK: $r4r5 = MOV32_F2 $r0r1
    ; CHECK: STSP16 0, $r6
    ; CHECK: $r4 = LDSP16 2
    $r4r5 = MOV32_F2 $r0r1
    STSP16 0, $r6, implicit $sp :: (store (s16) into %stack.0, align 1)
    $r4 = LDSP16 2, implicit $sp :: (load (s16) from %stack.1, align 1)
    TST16 $r4, implicit-def $cc
    $r0 = COLDLDI16 1234
    $r6 = LDI16 5678
    RELAX_BR_NE %bb.1, implicit $cc
    RELAX_JMP %bb.2

  bb.2:
    liveins: $r4r5
    RET implicit-def dead $sp, implicit $sp, implicit $r4r5
...
