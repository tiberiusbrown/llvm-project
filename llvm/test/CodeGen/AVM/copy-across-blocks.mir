# RUN: llc -mtriple=avm -O2 -run-pass=avm-late-peephole \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

--- |
  target triple = "avm"
  define void @remove_repeated_pair() { ret void }
  define void @remove_inverse_pair() { ret void }
  define void @keep_source_half_clobber() { ret void }
  define void @keep_destination_half_clobber() { ret void }
  define void @keep_join_copy() { ret void }
  define void @keep_call_clobber() { ret void }
...
---
name: remove_repeated_pair
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $r0r1, $r4, $sp
    ; CHECK-LABEL: name: remove_repeated_pair
    ; CHECK: $r2r3 = MOV32_F2 $r0r1
    dead $r2r3 = MOV32_F2 $r0r1
    RELAX_JMP %bb.1
  bb.1:
    liveins: $r0r1, $r4, $sp
    ; CHECK: bb.1:
    ; CHECK: liveins: {{.*}}$r2r3
    ; CHECK: $r4 = INC16 $r4
    ; CHECK-NOT: MOV32_F2
    ; CHECK: RET
    $r4 = INC16 $r4
    $r2r3 = MOV32_F2 $r0r1
    RET implicit-def dead $sp, implicit $sp, implicit $r2r3, implicit $r4
...
---
name: remove_inverse_pair
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $r2r3, $sp
    ; CHECK-LABEL: name: remove_inverse_pair
    ; CHECK: $r0r1 = MOV32_F2 $r2r3
    $r0r1 = MOV32_F2 $r2r3
    RELAX_JMP %bb.1
  bb.1:
    liveins: $r0r1, $sp
    ; CHECK: bb.1:
    ; CHECK-NOT: MOV32_F2
    ; CHECK: RET
    $r2r3 = MOV32_F2 $r0r1
    RET implicit-def dead $sp, implicit $sp, implicit $r2r3
...
---
name: keep_source_half_clobber
body: |
  bb.0:
    successors: %bb.1
    liveins: $r0r1
    ; CHECK-LABEL: name: keep_source_half_clobber
    $r2r3 = MOV32_F2 $r0r1
    RELAX_JMP %bb.1
  bb.1:
    liveins: $r0r1
    ; CHECK: bb.1:
    ; CHECK: $r1 = COLDLDI16 9
    ; CHECK-NEXT: $r2r3 = MOV32_F2 $r0r1
    $r1 = COLDLDI16 9
    $r2r3 = MOV32_F2 $r0r1
    RET implicit-def dead $sp, implicit $sp, implicit $r2r3
...
---
name: keep_destination_half_clobber
body: |
  bb.0:
    successors: %bb.1
    liveins: $r0r1
    ; CHECK-LABEL: name: keep_destination_half_clobber
    $r2r3 = MOV32_F2 $r0r1
    RELAX_JMP %bb.1
  bb.1:
    liveins: $r0r1
    ; CHECK: bb.1:
    ; CHECK: $r3 = COLDLDI16 9
    ; CHECK-NEXT: $r2r3 = MOV32_F2 $r0r1
    $r3 = COLDLDI16 9
    $r2r3 = MOV32_F2 $r0r1
    RET implicit-def dead $sp, implicit $sp, implicit $r2r3
...
---
name: keep_join_copy
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r0r1, $cc
    ; CHECK-LABEL: name: keep_join_copy
    BREQ8 %bb.1, implicit $cc
    RELAX_JMP %bb.2
  bb.1:
    successors: %bb.3
    liveins: $r0r1
    $r2r3 = MOV32_F2 $r0r1
    RELAX_JMP %bb.3
  bb.2:
    successors: %bb.3
    liveins: $r0r1
    RELAX_JMP %bb.3
  bb.3:
    liveins: $r0r1
    ; CHECK: bb.3:
    ; CHECK: $r2r3 = MOV32_F2 $r0r1
    ; CHECK-NEXT: RET
    $r2r3 = MOV32_F2 $r0r1
    RET implicit-def dead $sp, implicit $sp, implicit $r2r3
...
---
name: keep_call_clobber
body: |
  bb.0:
    successors: %bb.1
    liveins: $r4r5
    ; CHECK-LABEL: name: keep_call_clobber
    $r0r1 = MOV32_F2 $r4r5
    RELAX_JMP %bb.1
  bb.1:
    ; CHECK: bb.1:
    ; CHECK: RELAX_CALL
    ; CHECK-NEXT: $r0r1 = MOV32_F2 $r4r5
    RELAX_CALL &callee, csr_avm_call, implicit-def $sp, implicit-def $cc, implicit $sp, implicit-def $r4r5
    $r0r1 = MOV32_F2 $r4r5
    RET implicit-def dead $sp, implicit $sp, implicit $r0r1
...
