# RUN: llc -mtriple=avm -O2 -run-pass=avm-tail-duplication \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

--- |
  target triple = "avm"
  define void @normal_limit() { ret void }
  define void @size_limit() #0 { ret void }
  attributes #0 = { optsize }
...
---
name: normal_limit
body: |
  bb.0:
    successors: %bb.3(0x80000000)
    liveins: $r4, $r5

    ; CHECK-LABEL: name: normal_limit
    ; CHECK:       bb.0:
    ; CHECK:       $r4 = ADD16_PSEUDO $r4, $r5
    ; CHECK-NEXT:  $r4 = ADD16_PSEUDO $r4, $r5
    ; CHECK-NEXT:  $r4 = ADD16_PSEUDO $r4, $r5
    ; CHECK-NEXT:  $r4 = ADD16_PSEUDO $r4, $r5
    ; CHECK-NEXT:  CMP16_PSEUDO $r4, $r5, implicit-def $cc
    ; CHECK-NEXT:  BR_CC_PSEUDO %bb.4, 1, implicit $cc
    ; CHECK-NOT:   JMP_PSEUDO
    ; CHECK:       bb.1:
    JMP_PSEUDO %bb.3

  bb.1:
    RET_PSEUDO implicit-def dead $sp, implicit $sp

  bb.2:
    successors: %bb.3(0x80000000)
    liveins: $r4, $r5
    JMP_PSEUDO %bb.3

  bb.3:
    successors: %bb.1(0x10000000), %bb.4(0x70000000)
    liveins: $r4, $r5
    $r4 = ADD16_PSEUDO $r4, $r5
    $r4 = ADD16_PSEUDO $r4, $r5
    $r4 = ADD16_PSEUDO $r4, $r5
    $r4 = ADD16_PSEUDO $r4, $r5
    CMP16_PSEUDO $r4, $r5, implicit-def $cc
    BR_CC_PSEUDO %bb.1, 0, implicit $cc

  bb.4:
    RET_PSEUDO implicit-def dead $sp, implicit $sp
...
---
name: size_limit
body: |
  bb.0:
    successors: %bb.3(0x80000000)
    liveins: $r4, $r5

    ; CHECK-LABEL: name: size_limit
    ; CHECK:       bb.0:
    ; CHECK-NEXT:  successors: %bb.3
    ; CHECK:       JMP_PSEUDO %bb.3
    JMP_PSEUDO %bb.3

  bb.1:
    RET_PSEUDO implicit-def dead $sp, implicit $sp

  bb.2:
    successors: %bb.3(0x80000000)
    liveins: $r4, $r5
    JMP_PSEUDO %bb.3

  bb.3:
    successors: %bb.1(0x10000000), %bb.4(0x70000000)
    liveins: $r4, $r5
    $r4 = ADD16_PSEUDO $r4, $r5
    $r4 = ADD16_PSEUDO $r4, $r5
    $r4 = ADD16_PSEUDO $r4, $r5
    $r4 = ADD16_PSEUDO $r4, $r5
    CMP16_PSEUDO $r4, $r5, implicit-def $cc
    BR_CC_PSEUDO %bb.1, 0, implicit $cc

  bb.4:
    RET_PSEUDO implicit-def dead $sp, implicit $sp
...
