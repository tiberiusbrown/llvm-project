# RUN: llc -mtriple=avm -O2 -run-pass=machine-sink \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

# A tied accumulator update must stay in the loop header. Sinking it to
# the latch keeps both the old accumulator and its loaded addend live across
# the conditional body and causes avoidable spills in the eight-register file.
--- |
  target triple = "avm"
  @data = external global i8
  define i16 @loop_accumulator() { ret i16 0 }
...
---
name: loop_accumulator
tracksRegLiveness: true
body: |
  bb.0:
    %0:gpr16 = LDI8_PSEUDO 0
    %1:gpr16 = LDI8_PSEUDO 32
    %2:gpr16 = DATA_ADDR_PSEUDO @data
    JMP_PSEUDO %bb.1

  bb.1:
    ; CHECK-LABEL: bb.1:
    ; CHECK:       %[[ACC:[0-9]+]]:gpr16 = PHI
    ; CHECK:       ADD16_PSEUDO %[[ACC]]
    ; CHECK:       BR_CC_PSEUDO
    %3:gpr16 = PHI %0, %bb.0, %6, %bb.3
    %4:gpr16 = PHI %1, %bb.0, %9, %bb.3
    %5:gpr16 = LOAD8U_PSEUDO %2 :: (load (s8) from @data)
    %6:gpr16 = ADD16_PSEUDO %3, %5
    %7:gpr16 = LOAD8U_PSEUDO %2 :: (volatile load (s8) from @data)
    TST8_PSEUDO %7, implicit-def $cc
    BR_CC_PSEUDO %bb.3, 0, implicit $cc
    JMP_PSEUDO %bb.2

  bb.2:
    STORE8_PSEUDO %2, %7 :: (store (s8) into @data)
    JMP_PSEUDO %bb.3

  bb.3:
    ; CHECK-LABEL: bb.3:
    ; CHECK-NOT: ADD16_PSEUDO
    ; CHECK: DEC16_PSEUDO
    %9:gpr16 = DEC16_PSEUDO %4
    TST8_PSEUDO %9, implicit-def $cc
    BR_CC_PSEUDO %bb.1, 1, implicit $cc
    JMP_PSEUDO %bb.4

  bb.4:
    $r4 = COPY %6
    RET_PSEUDO implicit-def dead $sp, implicit $sp, implicit $r4
...
