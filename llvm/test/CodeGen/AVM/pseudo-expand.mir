# RUN: llc -mtriple=avm-unknown-arduboyfx -mcpu=avm1 -O2 \
# RUN:   -run-pass=avm-expand-pseudo -verify-machineinstrs %s -o - \
# RUN:   | FileCheck %s

--- |
  target triple = "avm-unknown-arduboyfx"
  define void @expand() { ret void }
...
---
name: expand
body: |
  bb.0:
    ; CHECK-LABEL: name: expand
    ; CHECK: $r4 = LDI8 42
    ; CHECK-NEXT: $r0 = COLDLDI8 42
    ; CHECK-NEXT: $r5 = LDI16 4660
    ; CHECK-NEXT: $r1 = COLDLDI16 4660
    ; CHECK-NEXT: $r4 = ADD $r4, $r5
    ; CHECK-NEXT: $r0 = ADD_RR $r0, $r1
    ; CHECK-NEXT: RET implicit-def dead $sp, implicit $sp
    $r4 = LDI8_PSEUDO 42
    $r0 = LDI8_PSEUDO 42
    $r5 = LDI16_PSEUDO 4660
    $r1 = LDI16_PSEUDO 4660
    $r4 = ADD16_PSEUDO $r4, $r5
    $r0 = ADD16_PSEUDO $r0, $r1
    RET_PSEUDO implicit-def dead $sp, implicit $sp
...
