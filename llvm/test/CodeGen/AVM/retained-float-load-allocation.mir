# RUN: llc -mtriple=avm -O2 -run-pass=avm-fixed-float-regs,phi-node-elimination,two-address-instruction,register-coalescer,greedy,virt-reg-rewriter \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=avm -run-pass=avm-fixed-float-regs -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=CLASS

# Keep repeated floating operands through min/max services in lower pairs.
# Pinning a load to its first Q2/Q3 operand copy causes a pair spill plus
# repeated reloads while narrower loop state can use short scalar spills.
--- |
  target triple = "avm"
  @result = external global i16
  define i16 @retained_ff_load_pressure() { ret i16 0 }
  define float @arithmetic_reuse() { ret float 0.0 }
...
---
# CLASS-LABEL: name: retained_ff_load_pressure
# CLASS: %{{[0-9]+}}:retainedfp32 = LOAD32_PSEUDO
# CLASS: %{{[0-9]+}}:retainedfp32 = LOAD32_PSEUDO
name: retained_ff_load_pressure
isSSA: true
tracksRegLiveness: true
body: |
  bb.0:
    %44:gpr16 = LDI16_PSEUDO 320
    %45:gpr16 = LDI16_PSEUDO 256
    %43:gpr16 = LDI8_PSEUDO 0
    JMP_PSEUDO %bb.1
  bb.1:
    ; CHECK-LABEL: name: retained_ff_load_pressure
    ; CHECK: $r{{0r1|2r3}} = LOAD32_PSEUDO
    ; CHECK-NOT: STACK_STORE32_PSEUDO
    ; CHECK: FCMP_PSEUDO
    ; CHECK-NOT: STACK_LOAD32_PSEUDO
    ; CHECK: RET_PSEUDO
    %13:gpr16 = PHI %44:gpr16, %bb.0, %20:gpr16, %bb.1
    %14:gpr16 = PHI %45:gpr16, %bb.0, %19:gpr16, %bb.1
    %15:gpr16 = PHI %43:gpr16, %bb.0, %18:gpr16, %bb.1
    %16:gpr16 = PHI %43:gpr16, %bb.0, %17:gpr16, %bb.1
    %47:gpr32 = LDI32_PSEUDO 0, 16256
    %48:q3only = COPY %47:gpr32
    %49:q2only = LOAD32_PSEUDO %14:gpr16
    %50:q3only = LOAD32_PSEUDO %13:gpr16
    %51:r6only = FCMP_PSEUDO %49:q2only, %50:q3only
    CMPIS8_PSEUDO %51:r6only, 1, implicit-def $cc
    %54:q2only = CMOV32_PSEUDO %49:q2only, %50:q3only(tied-def 0), 0, implicit $cc
    %55:r6only = FCMP_PSEUDO %54:q2only, %48:q3only
    %58:gpr16 = LDI8_PSEUDO 7
    %59:uppergpr16 = AND16_PSEUDO %15:gpr16(tied-def 0), %58:gpr16
    CMPIS8_PSEUDO %55:r6only, 2, implicit-def $cc
    %60:uppergpr16 = CSET_PSEUDO 2, implicit $cc
    %61:uppergpr16 = nuw nsw SHL16V_PSEUDO %60:uppergpr16(tied-def 0), %59:uppergpr16
    CMPIS8_PSEUDO %51:r6only, -1, implicit-def $cc
    %62:q2only = CMOV32_PSEUDO %49:q2only, %50:q3only(tied-def 0), 0, implicit $cc
    TST16_PSEUDO %51:r6only, implicit-def $cc
    %63:gpr16 = CSET_PSEUDO 0, implicit $cc
    %64:gpr16 = ADD16_PSEUDO %16:gpr16(tied-def 0), %63:gpr16
    %65:gpr16 = CSET_PSEUDO 1, implicit $cc
    %66:gpr16 = ADD16_PSEUDO %64:gpr16(tied-def 0), %65:gpr16
    %67:gpr32 = LDI32_PSEUDO 0, 0
    %68:q3only = COPY %67:gpr32
    %69:r6only = FCMP_PSEUDO %62:q2only, %68:q3only
    CMPIS8_PSEUDO %69:r6only, -1, implicit-def $cc
    %72:gpr16 = CSET_PSEUDO 0, implicit $cc
    %73:gpr16 = ADD16_PSEUDO %66:gpr16(tied-def 0), %72:gpr16
    %17:gpr16 = XOR16_PSEUDO %73:gpr16(tied-def 0), %61:uppergpr16
    %20:gpr16 = ADDIS8_PSEUDO %13:gpr16(tied-def 0), 4
    %19:gpr16 = ADDIS8_PSEUDO %14:gpr16(tied-def 0), 4
    %18:gpr16 = nuw nsw INC16_PSEUDO %15:gpr16(tied-def 0)
    CMPIS8_PSEUDO %18:gpr16, 16, implicit-def $cc
    BR_CC_PSEUDO %bb.2, 0, implicit $cc
    JMP_PSEUDO %bb.1
  bb.2:
    ABS_STORE16_PSEUDO @result, %17
    %200:gpr16 = LDI8_PSEUDO 0
    $r4 = COPY %200
    RET_PSEUDO implicit-def dead $sp, implicit $sp, implicit $r4
...

# Arithmetic reuse alone retains the ordinary allocation policy; only the
# repeated comparison/select pattern requires the retained FP class.
---
name: arithmetic_reuse
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r4
    ; CLASS-LABEL: name: arithmetic_reuse
    ; CLASS: %{{[0-9]+}}:gpr32 = LOAD32_PSEUDO
    ; CLASS-NOT: retainedfp32
    ; CLASS: RET_PSEUDO
    %0:gpr16 = COPY $r4
    %1:q2only = LOAD32_PSEUDO %0
    %2:q3only = LDI32_PSEUDO 0, 16128
    %3:q2only = FMUL_PSEUDO %1, %2
    %4:q2only = FADD_PSEUDO %3, %2
    %5:q2only = FADD_PSEUDO %1, %2
    $r4r5 = COPY %5
    RET_PSEUDO implicit-def dead $sp, implicit $sp, implicit $r4r5
...
