# RUN: llc -mtriple=avm -run-pass=avm-fixed-float-regs -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=avm -verify-machineinstrs %s -o %t.s
--- |
  define float @aliases(float %a, float %b) { ret float %a }
...
---
name: aliases
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r4r5, $r6r7
    %0:q2only = COPY $r4r5
    %1:q3only = COPY $r6r7
    %2:r6only = FCMP_PSEUDO %0, %1
    %3:q2only = FADD_PSEUDO %0, %1
    $r4r5 = COPY %3
    RET_PSEUDO implicit-def $sp, implicit $sp, implicit $r4r5
...
# CHECK: %0:gpr32 = COPY $r4r5
# CHECK: %1:gpr32 = COPY $r6r7
# CHECK: $r4r5 = COPY %0
# CHECK-NEXT: $r6r7 = COPY %1
# CHECK-NEXT: $r6 = FCMP_PSEUDO $r4r5, $r6r7
# CHECK-NEXT: %2:gpr16 = COPY $r6
# CHECK-NEXT: $r4r5 = COPY %0
# CHECK-NEXT: $r6r7 = COPY %1
# CHECK-NEXT: $r4r5 = FADD_PSEUDO $r4r5, $r6r7
# CHECK-NEXT: %3:gpr32 = COPY $r4r5
