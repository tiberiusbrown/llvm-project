# RUN: llc -mtriple=avm -run-pass=avm-system-service-regions \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

--- |
  define void @reused_mask() { ret void }
  define void @single_use_mask() { ret void }
...
---
name: reused_mask
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    ; Three bitwise uses in an integer loop justify a compact mask register.
    ; CHECK-LABEL: name: reused_mask
    ; CHECK: %0:uppergpr16 = nomerge LDI8_PSEUDO 63
    %0:gpr16 = LDI8_PSEUDO 63
    JMP_PSEUDO %bb.1
  bb.1:
    successors: %bb.1, %bb.2
    %1:gpr16 = IMPLICIT_DEF
    %2:gpr16 = AND16_PSEUDO %1, %0
    %3:gpr16 = XOR16_PSEUDO %2, %0
    %4:gpr16 = OR16_PSEUDO %3, %0
    CMP16_PSEUDO %1, %4, implicit-def $cc
    BR_CC_PSEUDO %bb.1, 1, implicit $cc
    JMP_PSEUDO %bb.2
  bb.2:
    $r4 = COPY %4
    RET_PSEUDO implicit-def dead $sp, implicit $sp, implicit $r4
...
---
name: single_use_mask
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    ; A local single-use mask keeps ordinary allocation.
    ; CHECK-LABEL: name: single_use_mask
    ; CHECK: %0:gpr16 = LDI8_PSEUDO 63
    JMP_PSEUDO %bb.1
  bb.1:
    successors: %bb.1, %bb.2
    %0:gpr16 = LDI8_PSEUDO 63
    %1:gpr16 = IMPLICIT_DEF
    %2:gpr16 = AND16_PSEUDO %1, %0
    CMP16_PSEUDO %1, %2, implicit-def $cc
    BR_CC_PSEUDO %bb.1, 1, implicit $cc
    JMP_PSEUDO %bb.2
  bb.2:
    $r4 = COPY %2
    RET_PSEUDO implicit-def dead $sp, implicit $sp, implicit $r4
...
