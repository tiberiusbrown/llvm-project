# RUN: llc -mtriple=avm -run-pass=machinelicm -verify-machineinstrs %s -o - | FileCheck %s
# Full spill reloads can be hoisted out of a loop. Ordered accesses and stores
# remain in place; the target must not describe an extending load as a reload.
---
name: invariant_spill_reload
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 4, alignment: 1 }
  - { id: 1, type: spill-slot, size: 2, alignment: 1 }
body: |
  bb.0:
    successors: %bb.1
    liveins: $r4r5, $r6
    ; CHECK-LABEL: name: invariant_spill_reload
    ; CHECK: bb.0:
    ; CHECK: STACK_STORE32_PSEUDO
    ; CHECK: STACK_STORE16_PSEUDO
    ; CHECK: $r0r1 = STACK_LOAD32_PSEUDO %stack.0
    ; CHECK: $r2 = STACK_LOAD16_PSEUDO %stack.1
    ; CHECK: RELAX_JMP %bb.1
    STACK_STORE32_PSEUDO %stack.0, 0, $r4r5, implicit $sp :: (store (s32) into %stack.0, align 1)
    STACK_STORE16_PSEUDO %stack.1, 0, $r6, implicit $sp :: (store (s16) into %stack.1, align 1)
    RELAX_JMP %bb.1

  bb.1:
    successors: %bb.1, %bb.2
    liveins: $r6
    ; CHECK: bb.1:
    ; CHECK-NOT: STACK_LOAD32_PSEUDO
    ; CHECK: $r7 = STACK_LOAD8U_PSEUDO
    ; CHECK: $r3 = STACK_LOAD16_PSEUDO {{.*}}volatile
    $r0r1 = STACK_LOAD32_PSEUDO %stack.0, 0, implicit $sp :: (load (s32) from %stack.0, align 1)
    $r2 = STACK_LOAD16_PSEUDO %stack.1, 0, implicit $sp :: (load (s16) from %stack.1, align 1)
    $r7 = STACK_LOAD8U_PSEUDO %stack.0, 0, implicit $sp :: (load (s8) from %stack.0)
    $r3 = STACK_LOAD16_PSEUDO %stack.1, 0, implicit $sp :: (volatile load (s16) from %stack.1, align 1)
    TST16 $r6, implicit-def $cc
    RELAX_BR_NE %bb.1, implicit $cc
    RELAX_JMP %bb.2

  bb.2:
    liveins: $r0r1, $r2, $r3, $r7
    RET_PSEUDO implicit-def dead $sp, implicit $sp, implicit $r0r1, implicit $r2, implicit $r3, implicit $r7
...
