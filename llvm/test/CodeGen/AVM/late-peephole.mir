# RUN: llc -mtriple=avm -O2 -run-pass=avm-late-peephole \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

--- |
  target triple = "avm"
  define void @reuse_signed_compare() { ret void }
  define void @changed_compare_operand() { ret void }
  define void @remove_spill_roundtrip() { ret void }
  define void @keep_live_spill() { ret void }
  define void @remove_reload_with_successor_reader() { ret void }
  define void @remove_wide_reload() { ret void }
  define void @keep_ordered_roundtrips() { ret void }
  define void @keep_distinct_reloads() { ret void }
  define void @keep_join_reload() { ret void }
  define void @select_by_bit_one() { ret void }
  define void @keep_live_cc() { ret void }
  define void @remove_redundant_zext() { ret void }
  define void @keep_needed_zext() { ret void }
...
---
name: reuse_signed_compare
body: |
  bb.0:
    liveins: $r4, $r5
    ; CHECK-LABEL: name: reuse_signed_compare
    ; CHECK: CMP $r5, $r4, implicit-def $cc
    ; CHECK: $r7 = CMOV_SLT $r7, $r4, implicit $cc
    ; CHECK-NOT: CMP $r4, $r5
    ; CHECK: $r5 = CMOV_SGE $r5, $r4, implicit $cc
    CMP $r5, $r4, implicit-def $cc
    $r7 = MOV $r5
    $r7 = CMOV_SLT $r7, $r4, implicit $cc
    CMP $r4, $r5, implicit-def $cc
    $r5 = CMOV_SLT $r5, $r4, implicit $cc
    RET implicit-def dead $sp, implicit $sp
...
---
name: changed_compare_operand
body: |
  bb.0:
    liveins: $r4, $r5
    ; CHECK-LABEL: name: changed_compare_operand
    ; CHECK: CMP $r5, $r4, implicit-def $cc
    ; CHECK: $r5 = ADD $r5, $r4
    ; CHECK: CMP $r4, $r5, implicit-def $cc
    ; CHECK: $r5 = CMOV_SLT $r5, $r4, implicit $cc
    CMP $r5, $r4, implicit-def $cc
    $r5 = ADD $r5, $r4
    CMP $r4, $r5, implicit-def $cc
    $r5 = CMOV_SLT $r5, $r4, implicit $cc
    RET implicit-def dead $sp, implicit $sp
...
---
name: remove_spill_roundtrip
stack:
  - { id: 0, type: spill-slot, offset: 6, size: 2, alignment: 1 }
body: |
  bb.0:
    liveins: $r2, $sp
    ; CHECK-LABEL: name: remove_spill_roundtrip
    ; CHECK: $r6 = LDI8 7
    ; CHECK-NEXT: $r6 = AND_RR $r6, $r2
    ; CHECK-NEXT: STSP16_COMPACT 6, $r6, implicit $sp
    $r6 = LDI8 7
    STSP16_COMPACT 6, $r6, implicit $sp :: (store (s16) into %stack.0, align 1)
    $r6 = LDSP16_COMPACT 6, implicit $sp :: (load (s16) from %stack.0, align 1)
    $r6 = AND_RR $r6, $r2
    STSP16_COMPACT 6, $r6, implicit $sp :: (store (s16) into %stack.0, align 1)
    RET implicit-def dead $sp, implicit $sp
...
---
name: keep_live_spill
stack:
  - { id: 0, type: spill-slot, offset: 6, size: 2, alignment: 1 }
body: |
  bb.0:
    liveins: $r2, $sp
    ; CHECK-LABEL: name: keep_live_spill
    ; CHECK: STSP16_COMPACT 6, $r6, implicit $sp
    ; CHECK-NEXT: $r4 = MOV $r6
    ; CHECK: STSP16_COMPACT 6, $r6, implicit $sp
    $r6 = LDI8 7
    STSP16_COMPACT 6, $r6, implicit $sp :: (store (s16) into %stack.0, align 1)
    $r6 = LDSP16_COMPACT 6, implicit $sp :: (load (s16) from %stack.0, align 1)
    $r4 = LDSP16_COMPACT 6, implicit $sp :: (load (s16) from %stack.0, align 1)
    $r6 = AND_RR $r6, $r2
    STSP16_COMPACT 6, $r6, implicit $sp :: (store (s16) into %stack.0, align 1)
    RET implicit-def dead $sp, implicit $sp
...
---
name: remove_reload_with_successor_reader
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, offset: 26, size: 2, alignment: 1 }
body: |
  bb.0:
    successors: %bb.1
    liveins: $r4, $sp
    ; CHECK-LABEL: name: remove_reload_with_successor_reader
    ; CHECK: STSP16 26, $r4, implicit $sp
    ; CHECK-NEXT: $r5 = MOV $r4
    ; CHECK-NEXT: RELAX_JMP %bb.1
    STSP16 26, killed $r4, implicit $sp :: (store (s16) into %stack.0, align 1)
    $r4 = LDSP16 26, implicit $sp :: (load (s16) from %stack.0, align 1)
    $r5 = MOV $r4
    RELAX_JMP %bb.1

  bb.1:
    liveins: $sp
    ; CHECK: $r6 = LDSP16 26, implicit $sp
    $r6 = LDSP16 26, implicit $sp :: (load (s16) from %stack.0, align 1)
    RET implicit-def dead $sp, implicit $sp
...
---
name: remove_wide_reload
stack:
  - { id: 0, type: spill-slot, offset: 32, size: 2, alignment: 1 }
body: |
  bb.0:
    liveins: $r0, $sp
    ; CHECK-LABEL: name: remove_wide_reload
    ; CHECK: STSP16 32, $r0, implicit $sp
    ; CHECK-NEXT: $r4 = MOV_RR $r0
    STSP16 32, $r0, implicit $sp :: (store (s16) into %stack.0, align 1)
    $r0 = LDSP16 32, implicit $sp :: (load (s16) from %stack.0, align 1)
    $r4 = MOV_RR $r0
    RET implicit-def dead $sp, implicit $sp
...
---
name: keep_ordered_roundtrips
stack:
  - { id: 0, type: spill-slot, offset: 6, size: 2, alignment: 1 }
body: |
  bb.0:
    liveins: $r4, $sp
    ; CHECK-LABEL: name: keep_ordered_roundtrips
    ; CHECK: STSP16_COMPACT 6, $r4, implicit $sp
    ; CHECK-NEXT: $r4 = LDSP16_COMPACT 6, implicit $sp
    ; CHECK-NEXT: $r4 = LDSP16_COMPACT 6, implicit $sp
    STSP16_COMPACT 6, $r4, implicit $sp :: (volatile store (s16) into %stack.0, align 1)
    $r4 = LDSP16_COMPACT 6, implicit $sp :: (load (s16) from %stack.0, align 1)
    STSP16_COMPACT 6, $r4, implicit $sp :: (store (s16) into %stack.0, align 1)
    $r4 = LDSP16_COMPACT 6, implicit $sp :: (volatile load (s16) from %stack.0, align 1)
    RET implicit-def dead $sp, implicit $sp
...
---
name: keep_distinct_reloads
stack:
  - { id: 0, type: spill-slot, offset: 6, size: 2, alignment: 1 }
  - { id: 1, type: spill-slot, offset: 8, size: 2, alignment: 1 }
body: |
  bb.0:
    liveins: $r4, $r5, $sp
    ; CHECK-LABEL: name: keep_distinct_reloads
    ; CHECK: STSP16_COMPACT 6, $r4, implicit $sp
    ; CHECK-NEXT: $r4 = LDSP16_COMPACT 8, implicit $sp
    ; CHECK-NEXT: STSP16_COMPACT 8, $r5, implicit $sp
    ; CHECK-NEXT: $r4 = MOV $r5
    STSP16_COMPACT 6, $r4, implicit $sp :: (store (s16) into %stack.0, align 1)
    $r4 = LDSP16_COMPACT 8, implicit $sp :: (load (s16) from %stack.1, align 1)
    STSP16_COMPACT 8, $r5, implicit $sp :: (store (s16) into %stack.1, align 1)
    $r4 = LDSP16_COMPACT 8, implicit $sp :: (load (s16) from %stack.1, align 1)
    RET implicit-def dead $sp, implicit $sp
...
---
name: keep_join_reload
stack:
  - { id: 0, type: spill-slot, offset: 26, size: 2, alignment: 1 }
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r4, $cc, $sp
    RELAX_BR_EQ %bb.2, implicit $cc

  bb.1:
    successors: %bb.2
    liveins: $r4, $sp
    ; CHECK-LABEL: name: keep_join_reload
    ; CHECK: STSP16 26, killed $r4, implicit $sp
    STSP16 26, killed $r4, implicit $sp :: (store (s16) into %stack.0, align 1)

  bb.2:
    liveins: $sp
    ; CHECK: bb.2:
    ; CHECK: $r4 = LDSP16 26, implicit $sp
    $r4 = LDSP16 26, implicit $sp :: (load (s16) from %stack.0, align 1)
    RET implicit-def dead $sp, implicit $sp
...
---
name: select_by_bit_one
body: |
  bb.0:
    liveins: $r6, $r7
    ; CHECK-LABEL: name: select_by_bit_one
    ; CHECK: $r4 = LDI8 2
    ; CHECK-NEXT: $r4 = AND $r4, $r6
    ; CHECK-NEXT: TST8 $r4, implicit-def $cc
    ; CHECK-NEXT: $r4 = XOR $r4, $r4
    ; CHECK-NEXT: $r4 = CMOV_NE $r4, $r6, implicit $cc
    ; CHECK-NEXT: $r4 = XOR $r4, $r7
    $r4 = MOV $r6
    $r4 = LSL16I $r4, 14
    $r4 = ASR16I $r4, 15
    $r4 = AND $r4, $r6
    $r4 = XOR $r4, $r7
    RET implicit-def dead $sp, implicit $sp
...
---
name: keep_live_cc
body: |
  bb.0:
    liveins: $r5, $r6, $r7
    ; CHECK-LABEL: name: keep_live_cc
    ; CHECK: $r4 = MOV $r6
    ; CHECK-NEXT: $r4 = LSL16I $r4, 14
    ; CHECK-NEXT: $r4 = ASR16I $r4, 15
    ; CHECK-NEXT: $r4 = AND $r4, $r6
    ; CHECK-NEXT: $r7 = CMOV_EQ $r7, $r5, implicit $cc
    CMP $r5, $r6, implicit-def $cc
    $r4 = MOV $r6
    $r4 = LSL16I $r4, 14
    $r4 = ASR16I $r4, 15
    $r4 = AND $r4, $r6
    $r7 = CMOV_EQ $r7, $r5, implicit $cc
    RET implicit-def dead $sp, implicit $sp
...
---
name: remove_redundant_zext
body: |
  bb.0:
    ; CHECK-LABEL: name: remove_redundant_zext
    ; CHECK: $r4 = LDI8 5
    ; CHECK-NEXT: $r5 = MOV $r4
    ; CHECK-NOT: ZEXT8
    $r4 = LDI8 5
    $r4 = ZEXT8 $r4
    $r5 = MOV $r4
    RET implicit-def dead $sp, implicit $sp
...
---
name: keep_needed_zext
body: |
  bb.0:
    liveins: $r5
    ; CHECK-LABEL: name: keep_needed_zext
    ; CHECK: $r4 = LDI8 5
    ; CHECK-NEXT: $r4 = ADD $r4, $r5
    ; CHECK-NEXT: $r4 = ZEXT8 $r4
    $r4 = LDI8 5
    $r4 = ADD $r4, $r5
    $r4 = ZEXT8 $r4
    RET implicit-def dead $sp, implicit $sp
...
