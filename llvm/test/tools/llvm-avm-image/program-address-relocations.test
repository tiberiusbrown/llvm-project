# RUN: split-file %s %t
# RUN: llvm-mc -triple=avm-unknown-arduboyfx -filetype=obj %t/program.s -o %t/program.o
# RUN: llvm-avm-image create %t/program.o -o %t/program.bin
# RUN: llvm-avm-image validate %t/program.bin | FileCheck %s --check-prefix=VALID
# RUN: od -A n -t x1 -v -j 256 -N 14 %t/program.bin | FileCheck %s --check-prefix=BYTES

# VALID: valid AVM image
# BYTES: e8 00 e0 86 0a 01 fd 80 0c ff d3 5a c7 80

#--- program.s
.section .text,"ax",@progbits
.globl _start
_start:
  ldpbi prog_hi8(ldp_test_data)
  ldi16 r6, prog_lo16(ldp_test_data)
  ldp8 r0, [pb:r6]
  ret

.section .rodata,"a",@progbits
ldp_test_data:
  .byte 0xd3, 0x5a, 0xc7, 0x80
