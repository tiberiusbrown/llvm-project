# RUN: split-file %s %t
# RUN: llvm-mc -triple=avm-unknown-arduboyfx -filetype=obj %t/program.s -o %t/program.o
# RUN: llvm-avm-image create %t/program.o -o %t/program.bin
# RUN: llvm-avm-image validate %t/program.bin | FileCheck %s --check-prefix=VALID
# RUN: llvm-avm-image inspect %t/program.bin | FileCheck %s --check-prefix=INSPECT
# RUN: od -A n -t x1 -v -j 256 -N 14 %t/program.bin | FileCheck %s --check-prefix=BYTES
# RUN: llvm-mc -triple=avm-unknown-arduboyfx -filetype=obj %t/odd.s -o %t/odd.o
# RUN: not llvm-avm-image create %t/odd.o -o %t/odd.bin 2>&1 | FileCheck %s --check-prefix=ERROR

# VALID: valid AVM image
# INSPECT: AVM image
# INSPECT: runtimeVersion: 1
# INSPECT: entryPoint: 0x000100
# INSPECT: dataSize: 0
# INSPECT: staticSize: 0
# INSPECT: headerCrc32: 0x
# BYTES: ea 0e 01 eb 10 01 fe 10 01 00 fe 0f 01 00
# ERROR: AVM far target must be two-byte aligned

#--- program.s
.text
.globl _start
_start:
  jmp16 .Lnear
  call16 global_target + 2
  jmpf .Lfar
  callf global_target
.Lnear:
.globl global_target
global_target:
  nop
.p2align 1
.Lfar:
  nop

#--- odd.s
.text
.globl _start
.p2align 1
_start:
  jmpf odd_target
  nop
odd_target:
  nop
