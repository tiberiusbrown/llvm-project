// ELF relocations for the Arduboy Virtual Machine.
//
// This is a private development e_machine and relocation namespace.  The
// values are deliberately kept small and stable so early objects remain
// readable while the target is experimental.
ELF_RELOC(R_AVM_NONE,       0)
ELF_RELOC(R_AVM_DATA16,     1)
ELF_RELOC(R_AVM_PROG24,     2)
ELF_RELOC(R_AVM_PROG_LO16,  3)
ELF_RELOC(R_AVM_PROG_HI8,   4)
ELF_RELOC(R_AVM_PCREL8,     5)
ELF_RELOC(R_AVM_PCREL16,    6)
ELF_RELOC(R_AVM_FAR24,      7)
ELF_RELOC(R_AVM_RELAX,      8)
// DWARF32 section offsets and lengths are four bytes, independently of the
// three-byte AVM address size.
ELF_RELOC(R_AVM_32,         9)
// Unqualified 24-bit DWARF address, which may refer to either address space.
ELF_RELOC(R_AVM_DEBUG24,    10)
