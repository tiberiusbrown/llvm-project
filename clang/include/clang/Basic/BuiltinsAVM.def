// The format of this database matches clang/Basic/Builtins.def.

BUILTIN(__builtin_avm_flash_string, "cC*1cC*0", "nctE")
BUILTIN(__builtin_avm_memcpy_p, "v*v*vC*1Ui", "n")
BUILTIN(__avm_memcpy_P, "v*v*vC*1Ui", "nA")
BUILTIN(memcpy_P, "v*v*vC*1Ui", "nA")

BUILTIN(__builtin_avm_memcmp_p, "ivC*vC*1Ui", "nA")
BUILTIN(__avm_memcmp_P, "ivC*vC*1Ui", "nA")
BUILTIN(memcmp_P, "ivC*vC*1Ui", "nA")

BUILTIN(__builtin_avm_strcmp_p, "icC*cC*1", "nA")
BUILTIN(__avm_strcmp_P, "icC*cC*1", "nA")
BUILTIN(strcmp_P, "icC*cC*1", "nA")

BUILTIN(__builtin_avm_strlen_p, "UicC*1", "nA")
BUILTIN(__avm_strlen_P, "UicC*1", "nA")
BUILTIN(strlen_P, "UicC*1", "nA")

BUILTIN(__builtin_avm_strncpy_p, "c*c*cC*1Ui", "nA")
BUILTIN(__avm_strncpy_P, "c*c*cC*1Ui", "nA")
BUILTIN(strncpy_P, "c*c*cC*1Ui", "nA")

BUILTIN(__builtin_avm_strncat_p, "c*c*cC*1Ui", "nA")
BUILTIN(__avm_strncat_P, "c*c*cC*1Ui", "nA")
BUILTIN(strncat_P, "c*c*cC*1Ui", "nA")

BUILTIN(__avm_debug_putc, "vUc", "n")
BUILTIN(__avm_debug_break, "v", "n")
BUILTIN(__avm_millis, "Ui", "n")
BUILTIN(__avm_millis32, "ULi", "n")
BUILTIN(__avm_buttons, "Uc", "n")
BUILTIN(__avm_idle, "v", "n")
BUILTIN(__avm_generate_random_seed, "Ui", "n")
BUILTIN(__avm_save, "v", "n")
BUILTIN(__avm_load, "b", "n")
BUILTIN(__avm_save_exists, "b", "n")

BUILTIN(__avm_display, "vb", "n")

BUILTIN(__avm_draw_sprite_overwrite, "viivC*1Ui", "n")
BUILTIN(__avm_draw_sprite_plus_mask, "viivC*1Ui", "n")
BUILTIN(__avm_draw_sprite_self_masked, "viivC*1Ui", "n")
BUILTIN(__avm_draw_sprite_erase, "viivC*1Ui", "n")

BUILTIN(__avm_set_sprite, "vvC*1", "n")

BUILTIN(__avm_draw_overwrite, "viiUi", "n")
BUILTIN(__avm_draw_plus_mask, "viiUi", "n")
BUILTIN(__avm_draw_self_masked, "viiUi", "n")
BUILTIN(__avm_draw_erase, "viiUi", "n")

BUILTIN(__avm_draw_filled_rect_white, "viiUcUc", "n")
BUILTIN(__avm_draw_filled_rect_black, "viiUcUc", "n")

BUILTIN(__avm_sqrtf, "ff", "nc")
BUILTIN(__avm_sinf, "ff", "nc")
BUILTIN(__avm_cosf, "ff", "nc")
BUILTIN(__avm_atan2f, "fff", "nc")
BUILTIN(__avm_tanf, "ff", "nc")
BUILTIN(__avm_expf, "ff", "nc")
BUILTIN(__avm_logf, "ff", "nc")
BUILTIN(__avm_log2f, "ff", "nc")
BUILTIN(__avm_log10f, "ff", "nc")
BUILTIN(__avm_powf, "fff", "nc")
BUILTIN(__avm_hypotf, "fff", "nc")
BUILTIN(__avm_fmodf, "fff", "nc")

BUILTIN(__avm_memcpy, "v*v*vC*Ui", "nA")
BUILTIN(__avm_memset, "v*v*iUi", "nA")
BUILTIN(__avm_memmove, "v*v*vC*Ui", "nA")
BUILTIN(__avm_memcmp, "ivC*vC*Ui", "nA")
BUILTIN(__avm_strcmp, "icC*cC*", "nA")
BUILTIN(__avm_strlen, "UicC*", "nA")
BUILTIN(__avm_strncpy, "c*c*cC*Ui", "nA")
BUILTIN(__avm_strncat, "c*c*cC*Ui", "nA")

#undef BUILTIN
