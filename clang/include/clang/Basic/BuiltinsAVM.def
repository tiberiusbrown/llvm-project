// The format of this database matches clang/Basic/Builtins.def.

BUILTIN(__builtin_avm_flash_string, "cC*1cC*0", "nctE")
BUILTIN(__builtin_avm_memcpy_p, "v*0v*0vC*1Us", "n")

#undef BUILTIN
